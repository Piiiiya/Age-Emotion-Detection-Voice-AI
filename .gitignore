# ============================================================
# GITHUB CLEANUP - DATA, MODELS AND GENERATED OUTPUTS
# ============================================================

# Exclude dataset metadata and local dataset references
data/metadata/

# Exclude temporary audio files
outputs/temp/

# Exclude generated NumPy arrays
outputs/**/*.npy

# Exclude experimental models by default
models/**

# Keep only the models required by the application
!models/age/
!models/age/age_linear_svm.joblib
!models/age/age_svm_scaler.joblib

!models/gender/
!models/gender/gender_model.joblib
!models/gender/gender_scaler.joblib
!models/gender/gender_config.json

!models/emotion_cremad_svm_v5.joblib
!models/emotion_cremad_svm_v5_classes.json
